prefix=${pcfiledir}/../..
# theoradec installed pkg-config file

exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/../include

Name: theora
Description: Theora video codec (decoder)
Version: 1.2.0
Conflicts:

Libs: "-L${libdir}" -ltheoradec
Requires: ogg >= 1.3.4
Cflags: "-I${includedir}"
