prefix=C:/src/vcpkg/packages/glfw3_x64-windows-static
exec_prefix=${prefix}
includedir=C:/src/vcpkg/packages/glfw3_x64-windows-static/include
libdir=C:/src/vcpkg/packages/glfw3_x64-windows-static/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.5.1
URL: https://www.glfw.org/
Requires.private: 
Libs: -L${libdir} -lglfw3
Libs.private: -lgdi32
Cflags: -I${includedir}
